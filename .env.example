# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Models: build on Haiku, switch VERIFIER_MODEL to Opus once the logic works.
MATCH_MODEL=claude-haiku-5-5
AGENT_MODEL=claude-sonnet-5-5
VERIFIER_MODEL=claude-haiku-5-5
# VERIFIER_MODEL=claude-opus-5-5

# Postgres (docker compose)
POSTGRES_USER=accountable
POSTGRES_PASSWORD=accountable
POSTGRES_DB=accountable
DATABASE_URL=postgresql://accountable:accountable@localhost:5432/accountable

# Neo4j (docker compose). Set MEMORY=postgres to use the fallback table instead.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=accountable123
MEMORY=neo4j

# Stand-in switches: fake | real
RAILS=fake
AGENTS=fake
VERIFIER=fake
APPROVALS=fake

# Dashboard feed: replay | live
NEXT_PUBLIC_FEED=replay
